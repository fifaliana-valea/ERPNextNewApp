@model ERPNextNewApp.Models.Salary.StatistiqueTotal
@{
ViewData["Title"] = "Graphique des Statistiques Salaires";

var TotalNet = Model.TotalNet;
var TotalBrut = Model.TotalBut;
var TotalDeduction = Model.TotalDeduction;
var labels = Model.Salaries.Select(s => s.MonthLabel).ToArray();
var dataNet = Model.Salaries.Select(s => s.TotalNet).ToArray();
var dataEarnings = Model.Salaries.Select(s => s.TotalEarnings.Values.Sum()).ToArray();
var dataDeductions = Model.Salaries.Select(s => s.TotalDeductions.Values.Sum()).ToArray();
}

<div class="container-fluid mt-4">
    <h2 class="text-center mb-4">Graphique des Statistiques Salaires</h2>

    <!-- Formulaire de filtre -->
    <div class="card mb-4">
        <div class="card-body">
            <form method="get" asp-action="GrapheStatistique" class="row g-3">
                <div class="col-md-3">
                    <label for="annee" class="form-label">Année</label>
                    <select class="form-select" id="annee" name="annee">
                        <option value="0">Toutes années</option>
                        @for (int i = 2028; i >= 2028 - 5; i--)
                        {
                        <option value="@i" selected="@(i == ViewBag.SelectedYear)">@i</option>
                        }
                    </select>
                </div>
                <div class="col-md-3 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary me-2">Filtrer</button>
                    <a href="@Url.Action("Statistique")" class="btn btn-secondary">Réinitialiser</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Graphique encadré -->
    <div class="card shadow">
        <div class="card-body">
            <canvas id="statistiqueChart" height="100"></canvas>
        </div>
    </div>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    const labels = @Html.Raw(Json.Serialize(labels));
    const dataNet = @Html.Raw(Json.Serialize(dataNet));
    const dataEarnings = @Html.Raw(Json.Serialize(dataEarnings));
    const dataDeductions = @Html.Raw(Json.Serialize(dataDeductions));

    const totalNet = @Html.Raw(Json.Serialize(TotalNet));
    const totalBrut = @Html.Raw(Json.Serialize(TotalBrut));
    const totalDeduction = @Html.Raw(Json.Serialize(TotalDeduction));

    // Plugin personnalisé pour afficher les totaux avec couleur
    Chart.register({
        id: 'customTotals',
        afterDraw(chart) {
            const { ctx, chartArea: { top, right } } = chart;
            ctx.save();
            ctx.font = '14px Arial';
            ctx.textAlign = 'right';

            const lineHeight = 18;
            const x = right - 10;
            let y = top + 20;

            ctx.fillStyle = 'rgba(40, 167, 69, 1)';
            ctx.fillText('Total Brut : ' + totalBrut.toLocaleString('fr-FR', { minimumFractionDigits: 2 }) + ' Ar', x, y);

            y += lineHeight;
            ctx.fillStyle = 'rgba(220, 53, 69, 1)';
            ctx.fillText('Total Déductions : ' + totalDeduction.toLocaleString('fr-FR', { minimumFractionDigits: 2 }) + ' Ar', x, y);

            y += lineHeight;
            ctx.fillStyle = 'rgba(0, 123, 255, 1)';
            ctx.fillText('Total Net : ' + totalNet.toLocaleString('fr-FR', { minimumFractionDigits: 2 }) + ' Ar', x, y);

            ctx.restore();
        }
    });

    const ctx = document.getElementById('statistiqueChart').getContext('2d');

    const chart = new Chart(ctx, {
        type: 'line',
        data: {
            labels: labels,
            datasets: [
                {
                    label: 'Salaire Brut',
                    data: dataEarnings,
                    borderColor: 'rgba(40, 167, 69, 1)',
                    backgroundColor: 'rgba(40, 167, 69, 0.1)',
                    tension: 0.3,
                    fill: true,
                    pointBackgroundColor: 'rgba(40, 167, 69, 1)'
                },
                {
                    label: 'Déductions',
                    data: dataDeductions,
                    borderColor: 'rgba(220, 53, 69, 1)',
                    backgroundColor: 'rgba(220, 53, 69, 0.1)',
                    tension: 0.3,
                    fill: true,
                    pointBackgroundColor: 'rgba(220, 53, 69, 1)'
                },
                {
                    label: 'Salaire Net',
                    data: dataNet,
                    borderColor: 'rgba(0, 123, 255, 1)',
                    backgroundColor: 'rgba(0, 123, 255, 0.1)',
                    tension: 0.3,
                    fill: true,
                    pointBackgroundColor: 'rgba(0, 123, 255, 1)'
                }
            ]
        },
        options: {
            responsive: true,
            plugins: {
                legend: {
                    position: 'top'
                },
                title: {
                    display: true,
                    text: 'Répartition mensuelle des salaires',
                    font: {
                        size: 18
                    }
                }
            },
            scales: {
                y: {
                    beginAtZero: true,
                    ticks: {
                        callback: function (value) {
                            return value.toLocaleString('fr-FR', { minimumFractionDigits: 2 }) + " Ar";
                        }
                    }
                }
            }
        }
    });
</script>
}
