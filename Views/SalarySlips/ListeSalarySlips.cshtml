@model ERPNextNewApp.Models.Salary.AllSalarySlips

@{
    ViewData["Title"] = "Fiches de Paie";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-md-12">
            <h2>@ViewData["Title"]</h2>
        </div>
    </div>

    <!-- Formulaire de filtre -->
    <div class="card mb-4">
        <div class="card-body">
            <form method="get" asp-action="ListeSalarySlips" class="row g-3">
                <div class="col-md-3">
                    <label for="employeeId" class="form-label">Employé</label>
                    <select class="form-select" id="employeeId" name="employeeId">
                        <option value="">Tous les employés</option>
                        @foreach (var employee in ViewData["employees"] as IEnumerable<ERPNextNewApp.Models.Employee>)
                        {
                            <option value="@employee.Id">@employee.FullName</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label for="mois" class="form-label">Mois</label>
                    <select class="form-select" id="mois" name="mois">
                        <option value="0">Tous les mois</option>
                        @for (int i = 1; i <= 12; i++)
                        {
                            <option value="@i">@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(i)</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label for="annee" class="form-label">Année</label>
                    <select class="form-select" id="annee" name="annee">
                        <option value="0">Toutes années</option>
                        @for (int i = DateTime.Now.Year; i >= DateTime.Now.Year - 5; i--)
                        {
                            <option value="@i">@i</option>
                        }
                    </select>
                </div>
                <div class="col-md-3 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary me-2">Filtrer</button>
                    <a href="@Url.Action("ListeSalarySlips")" class="btn btn-secondary">Réinitialiser</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Tableau des salaires -->
    <div class="card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped table-hover mb-0">
                    <thead class="thead-light">
                        <tr>
                            <th>Employé</th>
                            <th>Mois/Année</th>

                            @* Afficher toutes les composantes earnings uniques *@
                            @if (Model.TotalEarnings != null)
                            {
                                foreach (var earningKey in Model.TotalEarnings.Keys)
                                {
                                    <th class="text-end">@earningKey</th>
                                }
                            }

                            @* Afficher toutes les composantes deductions uniques *@
                            @if (Model.TotalDeductions != null)
                            {
                                foreach (var deductionKey in Model.TotalDeductions.Keys)
                                {
                                    <th class="text-end">@deductionKey</th>
                                }
                            }

                            <th class="text-end">Net</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Rows != null && Model.Rows.Any())
                        {
                            foreach (var row in Model.Rows)
                            {
                                <tr>
                                    <td>@row.EmployeeName</td>
                                    <td>@row.MonthLabel</td>

                                    @* Pour chaque earning key, afficher la valeur ou 0.00 si absente *@
                                    @if (Model.TotalEarnings != null)
                                    {
                                        foreach (var earningKey in Model.TotalEarnings.Keys)
                                        {
                                            <td class="text-end">
                                                @(row.Earnings != null && row.Earnings.ContainsKey(earningKey) ? row.Earnings[earningKey].ToString("N2") : "0.00")
                                            </td>
                                        }
                                    }

                                    @* Pour chaque deduction key, afficher la valeur ou 0.00 si absente *@
                                    @if (Model.TotalDeductions != null)
                                    {
                                        foreach (var deductionKey in Model.TotalDeductions.Keys)
                                        {
                                            <td class="text-end">
                                                @(row.DeductionsTotal != null && row.DeductionsTotal.ContainsKey(deductionKey) ? row.DeductionsTotal[deductionKey].ToString("N2") : "0.00")
                                            </td>
                                        }
                                    }

                                    <td class="text-end fw-bold">@row.Net.ToString("N2")</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="@(2 + (Model.TotalEarnings?.Count ?? 0) + (Model.TotalDeductions?.Count ?? 0) + 1)" class="text-center">Aucune donnée disponible</td>
                            </tr>
                        }
                    </tbody>
                    @if (Model.Rows != null && Model.Rows.Any())
                    {
                        <tfoot class="fw-bold">
                            <tr>
                                <td>Total</td>
                                <td></td>

                                @* Totaux earnings *@
                                @if (Model.TotalEarnings != null)
                                {
                                    foreach (var earning in Model.TotalEarnings)
                                    {
                                        <td class="text-end">@earning.Value.ToString("N2")</td>
                                    }
                                }

                                @* Totaux deductions *@
                                @if (Model.TotalDeductions != null)
                                {
                                    foreach (var deduction in Model.TotalDeductions)
                                    {
                                        <td class="text-end">@deduction.Value.ToString("N2")</td>
                                    }
                                }

                                <td class="text-end">@Model.TotalNet.ToString("N2")</td>
                            </tr>
                        </tfoot>
                    }
                </table>
            </div>

            <!-- Pagination -->
            @if (Model.TotalPages > 1)
            {
                <div class="d-flex justify-content-between align-items-center p-3 border-top">
                    <nav>
                        <ul class="pagination mb-0">
                            <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                                <a class="page-link" href="@Url.Action("ListeSalarySlips", new { 
                                    page = Model.CurrentPage - 1, 
                                    pageSize = Model.PageSize,
                                    employeeId = Context.Request.Query["employeeId"],
                                    mois = Context.Request.Query["mois"],
                                    annee = Context.Request.Query["annee"]
                                })">Précédent</a>
                            </li>

                            @for (int i = 1; i <= Model.TotalPages; i++)
                            {
                                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                    <a class="page-link" href="@Url.Action("ListeSalarySlips", new { 
                                        page = i, 
                                        pageSize = Model.PageSize,
                                        employeeId = Context.Request.Query["employeeId"],
                                        mois = Context.Request.Query["mois"],
                                        annee = Context.Request.Query["annee"]
                                    })">@i</a>
                                </li>
                            }

                            <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                                <a class="page-link" href="@Url.Action("ListeSalarySlips", new { 
                                    page = Model.CurrentPage + 1, 
                                    pageSize = Model.PageSize,
                                    employeeId = Context.Request.Query["employeeId"],
                                    mois = Context.Request.Query["mois"],
                                    annee = Context.Request.Query["annee"]
                                })">Suivant</a>
                            </li>
                        </ul>
                    </nav>
                    <div class="text-muted small">
                        Page @Model.CurrentPage sur @Model.TotalPages - @Model.TotalItems éléments
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Pré-remplir les filtres avec les valeurs de l'URL
        document.addEventListener('DOMContentLoaded', function() {
            const urlParams = new URLSearchParams(window.location.search);
            
            if (urlParams.has('employeeId')) {
                document.getElementById('employeeId').value = urlParams.get('employeeId');
            }
            
            if (urlParams.has('mois')) {
                document.getElementById('mois').value = urlParams.get('mois');
            }
            
            if (urlParams.has('annee')) {
                document.getElementById('annee').value = urlParams.get('annee');
            }
            
            if (urlParams.has('pageSize')) {
                document.getElementById('pageSize').value = urlParams.get('pageSize');
            }
        });
    </script>
}