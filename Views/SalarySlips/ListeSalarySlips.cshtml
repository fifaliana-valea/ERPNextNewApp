@model ERPNextNewApp.ViewModels.SalarySlips.SalarySlipViewModel

@{
    ViewData["Title"] = "Fiches de Paie";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-md-12">
            <h2>@ViewData["Title"]</h2>
        </div>
    </div>

    <!-- Filtres -->
    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0">Filtres</h5>
        </div>
        <div class="card-body">
            <form method="get" class="form-row d-flex flex-wrap align-items-end">
                <div class="form-group me-4 mb-2">
                    <label for="mois" class="me-2">Mois:</label>
                    <select id="mois" name="mois" class="form-control" asp-for="SelectedMonth">
                        <option value="0">Tous les mois</option>
                        @foreach (var month in ViewBag.Months)
                        {
                            <option value="@month.Value">@month.Text</option>
                        }
                    </select>
                </div>

                <div class="form-group me-4 mb-2">
                    <label for="annee" class="me-2">Année:</label>
                    <select id="annee" name="annee" class="form-control" asp-for="SelectedYear">
                        <option value="0">Toutes les années</option>
                        @foreach (var year in ViewBag.Years)
                        {
                            <option value="@year.Value">@year.Text</option>
                        }
                    </select>
                </div>

                <div class="form-group me-4 mb-2">
                    <label for="employeeId" class="me-2">Employé:</label>
                    <select id="employeeId" name="employeeId" class="form-control" asp-for="SelectedEmployeeId">
                        <option value="">Tous les employés</option>
                        @foreach (var employee in Model.Employees)
                        {
                            <option value="@employee.Id">@employee.FullName</option>
                        }
                    </select>
                </div>

                <div class="form-group me-3 mb-2">
                    <button type="submit" class="btn btn-primary">Filtrer</button>
                </div>
                <div class="form-group mb-2">
                    <a href="@Url.Action("Index")" class="btn btn-secondary">Réinitialiser</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Tableau des salaires -->
    <div class="card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped table-hover mb-0">
                    <thead class="thead-light">
                        <tr>
                            <th>Employé</th>
                            <th>Mois</th> <!-- ✅ Nouvelle colonne -->
                            @if (Model.SalaryRows.Any())
                            {
                                foreach (var earning in Model.SalaryRows.First().Earnings)
                                {
                                    <th class="text-right">@earning.Key</th>
                                }
                            }
                            <th class="text-right">Déductions</th>
                            <th class="text-right">Net</th>
                            <th>Action</th> <!-- ✅ Nouvelle colonne -->
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.SalaryRows)
                        {
                            <tr>
                                <td>@row.EmployeeName</td>
                                <td>@row.MonthLabel</td> <!-- ✅ Mois affiché -->
                                @foreach (var earning in row.Earnings)
                                {
                                    <td class="text-right">@earning.Value.ToString("N2")</td>
                                }
                                <td class="text-right">@row.DeductionsTotal.ToString("N2")</td>
                                <td class="text-right font-weight-bold">@row.Net.ToString("N2")</td>
                                <td>
                                    <a class="btn btn-sm btn-outline-primary" title="Voir"
                                       href="@Url.Action("Details", "SalarySlips", new { id = row.SlipId })">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="font-weight-bold">
                        <tr>
                            <td>Total</td>
                            <td></td> <!-- ✅ Cellule vide pour la colonne Mois -->
                            @if (Model.SalaryRows.Any())
                            {
                                foreach (var earning in Model.SalaryRows.First().Earnings)
                                {
                                    <td class="text-right">
                                        @Model.SalaryRows.Sum(r => r.Earnings[earning.Key]).ToString("N2")
                                    </td>
                                }
                            }
                            <td class="text-right">@Model.SalaryRows.Sum(r => r.DeductionsTotal).ToString("N2")</td>
                            <td class="text-right">@Model.SalaryRows.Sum(r => r.Net).ToString("N2")</td>
                            <td></td> <!-- ✅ Cellule vide pour Action -->
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
</div>
