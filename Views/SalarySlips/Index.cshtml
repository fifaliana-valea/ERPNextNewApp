@model ERPNextNewApp.ViewModels.SalarySlips.SalarySlipIndexViewModel

@{
    ViewData["Title"] = "Fiches de Paie";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-md-12">
            <h2>@ViewData["Title"]</h2>
        </div>
    </div>

    <!-- Formulaire de filtrage -->
    <div class="card mb-4">
        <div class="card-header">
            <h5>Filtrer les fiches de paie</h5>
        </div>
        <div class="card-body">
            <form asp-action="Index" method="get">
                <input type="hidden" class="form-control" id="employeeId" name="employeeId" value="@Model.SelectedEmployeeId">
                <div class="row align-items-end">
                    <div class="col-md-3">
                        <div class="form-group mb-0">
                            <label for="mois">Mois:</label>
                            <select class="form-control" id="mois" name="mois">
                                <option value="0">Tous les mois</option>
                                @foreach (var month in Model.Months)
                                {
                                    <option value="@month.Key" selected="@(month.Key == Model.SelectedMonth)">@month.Value</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group mb-0">
                            <label for="annee">Année:</label>
                            <select class="form-control" id="annee" name="annee">
                                <option value="0">Toutes les années</option>
                                @foreach (var year in Model.Years)
                                {
                                    <option value="@year.Key" selected="@(year.Key == Model.SelectedYear)">@year.Value</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group mb-0 pt-2">
                            <button type="submit" class="btn btn-primary mr-2">Filtrer</button>
                            <a asp-action="Index" class="btn btn-secondary">Réinitialiser</a>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Infos de l'employé -->
    @if (Model.Employee != null)
    {
        <div class="card mb-4">
            <div class="card-header">
                <h5>Informations de l'employé</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-2">
                        @if (!string.IsNullOrEmpty(Model.Employee.PhotoUrl))
                        {
                            <img src="@Model.Employee.PhotoUrl" class="img-thumbnail" alt="Photo de l'employé" style="max-height: 150px;">
                        }
                        else
                        {
                            <div class="img-thumbnail text-center p-4" style="height: 150px; background-color: #f8f9fa;">
                                <i class="fas fa-user fa-4x text-secondary"></i>
                            </div>
                        }
                    </div>
                    <div class="col-md-10">
                        <div class="row">
                            <div class="col-md-4">
                                <p><strong>Nom complet:</strong> @Model.Employee.FullName</p>
                                <p><strong>ID Employé:</strong> @Model.Employee.Id</p>
                                <p><strong>Poste:</strong> @Model.Employee.Position</p>
                            </div>
                            <div class="col-md-4">
                                <p><strong>Département:</strong> @Model.Employee.Department</p>
                                <p><strong>Date d'embauche:</strong> @Model.Employee.HiringDate?.ToString("dd/MM/yyyy")</p>
                                <p><strong>Statut:</strong> @Model.Employee.Status</p>
                            </div>
                            <div class="col-md-4">
                                <p><strong>Email:</strong> @Model.Employee.Email</p>
                                <p><strong>Genre:</strong> @Model.Employee.Gender</p>
                                <p><strong>Entreprise:</strong> @Model.Employee.Company</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Tableau des fiches de paie -->
    <div class="card">
        <div class="card-header">
            <h5>Liste des fiches de paie</h5>
        </div>
        <div class="card-body">
            @if (Model.SalarySlips.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="thead-dark">
                            <tr>
                                <th>Période</th>
                                <th>Employé</th>
                                <th>Date de publication</th>
                                <th>Salaire Brut</th>
                                <th>Salaire Net</th>
                                <th>Statut</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var slip in Model.SalarySlips)
                            {
                                <tr>
                                    <td>@slip.StartDate au @slip.EndDate</td>
                                    <td>@slip.EmployeeName</td>
                                    <td>@slip.PostingDate</td>
                                    <td>@slip.GrossPay.ToString("N2") @slip.Currency</td>
                                    <td>@slip.NetPay.ToString("N2") @slip.Currency</td>
                                    <td>
                                        <span class="badge @(slip.Status == "Draft" ? "badge-warning" : "badge-success")">
                                            @slip.Status
                                        </span>
                                    </td>
                                    <td>
                                        <a asp-action="Details" asp-route-id="@slip.Name" class="btn btn-sm btn-info" title="Détails">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info">
                    Aucune fiche de paie trouvée avec les critères de recherche spécifiés.
                </div>
            }
        </div>
    </div>
</div>