@model ERPNextNewApp.Models.Salary.AllSalarySlips

@{
    ViewData["Title"] = "Détails des Salaires";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-md-12">
            <h2>@ViewData["Title"]</h2>
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
            }
            @if (TempData["WarningMessage"] != null)
            {
                <div class="alert alert-warning">@TempData["WarningMessage"]</div>
            }
        </div>
    </div>

    <!-- Résumé des totaux -->
    <div class="card mb-4">
        <div class="card-header">
            <h5 class="card-title mb-0">Totaux</h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-4">
                    <div class="card bg-light">
                        <div class="card-body">
                            <h6 class="card-subtitle mb-2 text-muted">Total Brut</h6>
                            <p class="card-text h4">@Model.TotalBrut.ToString("N2")</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card bg-light">
                        <div class="card-body">
                            <h6 class="card-subtitle mb-2 text-muted">Total Déductions</h6>
                            <p class="card-text h4">@Model.TotalDeduction.ToString("N2")</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card bg-light">
                        <div class="card-body">
                            <h6 class="card-subtitle mb-2 text-muted">Total Net</h6>
                            <p class="card-text h4">@Model.TotalNet.ToString("N2")</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Tableau des fiches de paie -->
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="card-title mb-0">Détail des fiches de paie</h5>
            <div class="text-muted small">
                @if (Model.TotalItems > 0)
                {
                    <span>Page @Model.CurrentPage sur @Model.TotalPages - @Model.TotalItems éléments</span>
                }
                else
                {
                    <span>Aucun élément à afficher</span>
                }
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped table-hover mb-0">
                    <thead class="thead-light">
                        <tr>
                            <th>Employé</th>
                            <th>Période</th>
                            
                            @foreach (var earning in Model.TotalEarnings.Keys)
                            {
                                <th class="text-end">@earning</th>
                            }
                            
                            @foreach (var deduction in Model.TotalDeductions.Keys)
                            {
                                <th class="text-end">@deduction</th>
                            }
                            
                            <th class="text-end">Net</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Rows != null && Model.Rows.Any())
                        {
                            foreach (var row in Model.Rows)
                            {
                                <tr>
                                    <td>@row.EmployeeName</td>
                                    <td>@row.MonthLabel</td>
                                    
                                    @foreach (var earning in Model.TotalEarnings.Keys)
                                    {
                                        <td class="text-end">
                                            @(row.Earnings.ContainsKey(earning) ? row.Earnings[earning].ToString("N2") : "0.00")
                                        </td>
                                    }
                                    
                                    @foreach (var deduction in Model.TotalDeductions.Keys)
                                    {
                                        <td class="text-end">
                                            @(row.DeductionsTotal.ContainsKey(deduction) ? row.DeductionsTotal[deduction].ToString("N2") : "0.00")
                                        </td>
                                    }
                                    
                                    <td class="text-end fw-bold">@row.Net.ToString("N2")</td>
                                    <td class="text-end">
                                        <a class="btn btn-sm btn-outline-primary" title="Voir" 
                                           href="@Url.Action("Details", "SalarySlips", new { id = row.SlipId })">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="@(2 + Model.TotalEarnings.Count + Model.TotalDeductions.Count + 2)" class="text-center">
                                    Aucune donnée disponible
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            @if (Model.TotalPages > 1)
            {
                <div class="d-flex justify-content-between align-items-center p-3 border-top">
                    <nav>
                        <ul class="pagination mb-0">
                            <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                                <a class="page-link" href="@Url.Action("DetailsSalaire", new { 
                                    page = Model.CurrentPage - 1, 
                                    pageSize = Model.PageSize,
                                    mois = ViewBag.Mois,
                                    annee = ViewBag.Annee
                                })">Précédent</a>
                            </li>

                            @for (int i = 1; i <= Model.TotalPages; i++)
                            {
                                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                    <a class="page-link" href="@Url.Action("DetailsSalaire", new { 
                                        page = i, 
                                        pageSize = Model.PageSize,
                                        mois = ViewBag.Mois,
                                        annee = ViewBag.Annee
                                    })">@i</a>
                                </li>
                            }

                            <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                                <a class="page-link" href="@Url.Action("DetailsSalaire", new { 
                                    page = Model.CurrentPage + 1, 
                                    pageSize = Model.PageSize,
                                    mois = ViewBag.Mois,
                                    annee = ViewBag.Annee
                                })">Suivant</a>
                            </li>
                        </ul>
                    </nav>
                    <div class="text-muted small">
                        Affichage de @((Model.CurrentPage - 1) * Model.PageSize + 1) à @Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalItems) sur @Model.TotalItems éléments
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Gestion du changement de taille de page
            document.getElementById('pageSize')?.addEventListener('change', function() {
                const pageSize = this.value;
                const url = new URL(window.location.href);
                url.searchParams.set('pageSize', pageSize);
                url.searchParams.set('page', 1); // Retour à la première page
                window.location.href = url.toString();
            });
        });
    </script>
}