@model ERPNextNewApp.Models.Salary.StatistiqueTotal

@{
    ViewData["Title"] = "Statistiques des Salaires";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-md-12">
            <h2>@ViewData["Title"]</h2>
        </div>
    </div>

    <!-- Formulaire de filtre -->
    <div class="card mb-4">
        <div class="card-body">
            <form method="get" asp-action="Statistique" class="row g-3">
                <div class="col-md-3">
                    <label for="annee" class="form-label">Année</label>
                    <select class="form-select" id="annee" name="annee">
                        <option value="0">Toutes années</option>
                        @for (int i = DateTime.Now.Year; i >= DateTime.Now.Year - 5; i--)
                        {
                            <option value="@i" selected="@(i == ViewBag.SelectedYear)">@i</option>
                        }
                    </select>
                </div>
                <div class="col-md-3 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary me-2">Filtrer</button>
                    <a href="@Url.Action("Statistique")" class="btn btn-secondary">Réinitialiser</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Résumé des totaux -->
    <div class="card mb-4">
        <div class="card-header">
            <h5 class="card-title mb-0">Totaux</h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-4">
                    <div class="card bg-light">
                        <div class="card-body">
                            <h6 class="card-subtitle mb-2 text-muted">Total Brut</h6>
                            <p class="card-text h4">@Model.TotalBut.ToString("N2")</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card bg-light">
                        <div class="card-body">
                            <h6 class="card-subtitle mb-2 text-muted">Total Déductions</h6>
                            <p class="card-text h4">@Model.TotalDeduction.ToString("N2")</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card bg-light">
                        <div class="card-body">
                            <h6 class="card-subtitle mb-2 text-muted">Total Net</h6>
                            <p class="card-text h4">@Model.TotalNet.ToString("N2")</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Tableau des statistiques par mois -->
    <div class="card">
        <div class="card-header">
            <h5 class="card-title mb-0">Détail par mois</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped table-hover mb-0">
                    <thead class="thead-light">
                        <tr>
                            <th>Mois</th>
                            
                            <!-- En-têtes pour les gains -->
                            @{
                                var allEarningTypes = Model.Salaries
                                    .SelectMany(s => s.TotalEarnings.Keys)
                                    .Distinct()
                                    .OrderBy(k => k)
                                    .ToList();
                            }
                            @foreach (var earningType in allEarningTypes)
                            {
                                <th class="text-end">@earningType</th>
                            }
                            
                            <!-- En-têtes pour les déductions -->
                            @{
                                var allDeductionTypes = Model.Salaries
                                    .SelectMany(s => s.TotalDeductions.Keys)
                                    .Distinct()
                                    .OrderBy(k => k)
                                    .ToList();
                            }
                            @foreach (var deductionType in allDeductionTypes)
                            {
                                <th class="text-end">@deductionType</th>
                            }
                            
                            <th class="text-end">Net</th>
                            <th class="text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Salaries != null && Model.Salaries.Any())
                        {
                            foreach (var salary in Model.Salaries)
                            {
                                <tr>
                                    <td>@salary.MonthLabel</td>
                                    
                                    <!-- Valeurs pour les gains -->
                                    @foreach (var earningType in allEarningTypes)
                                    {
                                        <td class="text-end">
                                            @(salary.TotalEarnings.ContainsKey(earningType) ? salary.TotalEarnings[earningType].ToString("N2") : "0.00")
                                        </td>
                                    }
                                    
                                    <!-- Valeurs pour les déductions -->
                                    @foreach (var deductionType in allDeductionTypes)
                                    {
                                        <td class="text-end">
                                            @(salary.TotalDeductions.ContainsKey(deductionType) ? salary.TotalDeductions[deductionType].ToString("N2") : "0.00")
                                        </td>
                                    }
                                    
                                    <td class="text-end fw-bold">@salary.TotalNet.ToString("N2")</td>
                                    <td>
                                        <a class="btn btn-sm btn-outline-primary" title="Voir"
                                           href="@Url.Action("DetailsSalaire", "SalarySlips", new { 
                                                     annee = Context.Request.Query["annee"], 
                                                     mois = salary.MonthLabel 
                                                 })">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="@(1 + allEarningTypes.Count + allDeductionTypes.Count + 1)" class="text-center">Aucune donnée disponible</td>
                            </tr>
                        }
                    </tbody>
                    @if (Model.Salaries != null && Model.Salaries.Any())
                    {
                        <tfoot class="fw-bold">
                            <tr>
                                <td>Total</td>

                                <!-- Totaux pour les gains -->
                                @foreach (var earningType in allEarningTypes)
                                {
                                    var total = Model.TotalGlobalEarnings.ContainsKey(earningType) ? Model.TotalGlobalEarnings[earningType] : 0;
                                    <td class="text-end">@total.ToString("N2")</td>
                                }

                                <!-- Totaux pour les déductions -->
                                @foreach (var deductionType in allDeductionTypes)
                                {
                                    var total = Model.TotalGlobalDeductions.ContainsKey(deductionType) ? Model.TotalGlobalDeductions[deductionType] : 0;
                                    <td class="text-end">@total.ToString("N2")</td>
                                }

                                <td class="text-end">@Model.TotalNet.ToString("N2")</td>
                            </tr>
                        </tfoot>
                    }
                </table>
            </div>
        </div>
    </div>
</div>