@model ERPNextNewApp.Models.Salary.SalarySlip

@{
    ViewData["Title"] = "Détails de la fiche de paie";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-md-12">
            <h2>@ViewData["Title"]</h2>
            <div class="float-right">
                <a href="@Url.Action("DownloadSalarySlip", "SalarySlips", new { slipId = Model.Name })"  class="btn btn-outline-danger mr-2">
                    <i class="fas fa-file-pdf"></i> Générer PDF
                </a>
                <a href="@Url.Action("Index", "SalarySlips", new { employeeId = Model.Employee })" class="btn btn-outline-secondary">
                    <i class="fas fa-arrow-left"></i> Retour
                </a>
            </div>
        </div>
    </div>

    <!-- Informations de base -->
    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0">Informations de base</h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-4">
                    <p><strong>Employé:</strong> @Model.EmployeeName</p>
                    <p><strong>ID Employé:</strong> @Model.Employee</p>
                    <p><strong>Entreprise:</strong> @Model.Company</p>
                </div>
                <div class="col-md-4">
                    <p><strong>Période:</strong> Du @Model.StartDate au @Model.EndDate</p>
                    <p><strong>Date de publication:</strong> @Model.PostingDate</p>
                    <p><strong>Statut:</strong> 
                        @{
                            var badgeClass = Model.Status switch
                            {
                                "Draft" => "badge-warning text-dark",
                                "Submitted" => "badge-info text-dark",
                                "Paid" => "badge-success text-dark",
                                "Cancelled" => "badge-danger text-dark",
                                _ => "badge-secondary text-dark"
                            };
                        }
                        <span class="badge @badgeClass">
                            @Model.Status
                        </span>
                    </p>
                </div>
                <div class="col-md-4">
                    <p><strong>Salaire Brut:</strong> @Model.GrossPay.ToString("N2") @Model.Currency</p>
                    <p><strong>Salaire Net:</strong> @Model.NetPay.ToString("N2") @Model.Currency</p>
                    <p><strong>Total Déductions:</strong> @((Model.GrossPay - Model.NetPay).ToString("N2")) @Model.Currency</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Gains -->
        <div class="col-md-6">
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">Gains</h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-striped table-hover mb-0">
                            <thead>
                                <tr>
                                    <th>Composant</th>
                                    <th class="text-right">Montant</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var earning in Model.Earnings)
                                {
                                    <tr>
                                        <td>@earning.SalaryComponentName</td>
                                        <td class="text-right">@earning.Amount.ToString("N2") @Model.Currency</td>
                                    </tr>
                                }
                                <tr class="table-active">
                                    <td><strong>Total Gains</strong></td>
                                    <td class="text-right"><strong>@Model.GrossPay.ToString("N2") @Model.Currency</strong></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Déductions -->
        <div class="col-md-6">
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">Déductions</h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-striped table-hover mb-0">
                            <thead>
                                <tr>
                                    <th>Composant</th>
                                    <th class="text-right">Montant</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var deduction in Model.Deductions)
                                {
                                    <tr>
                                        <td>@deduction.SalaryComponentName</td>
                                        <td class="text-right">@deduction.Amount.ToString("N2") @Model.Currency</td>
                                    </tr>
                                }
                                <tr class="table-active">
                                    <td><strong>Total Déductions</strong></td>
                                    <td class="text-right"><strong>@((Model.GrossPay - Model.NetPay).ToString("N2")) @Model.Currency</strong></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Résumé -->
    <div class="card">
        <div class="card-header">
            <h5 class="mb-0">Résumé</h5>
        </div>
        <div class="card-body">
            <div class="row justify-content-center">
                <div class="col-md-6">
                    <table class="table table-bordered">
                        <tr>
                            <th class="bg-secondary bg-opacity-25 text-dark">Salaire Brut</th>
                            <td class="text-right">@Model.GrossPay.ToString("N2") @Model.Currency</td>
                        </tr>
                        <tr>
                            <th class="bg-secondary bg-opacity-25 text-dark">Total Déductions</th>
                            <td class="text-right">@((Model.GrossPay - Model.NetPay).ToString("N2")) @Model.Currency</td>
                        </tr>
                        <tr class="bg-primary bg-opacity-25">
                            <th class="text-dark"><strong>Salaire Net</strong></th>
                            <td class="text-right text-dark"><strong>@Model.NetPay.ToString("N2") @Model.Currency</strong></td>
                        </tr>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
